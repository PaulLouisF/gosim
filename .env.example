# Speechmatics
SPEECHMATICS_API_KEY=your_key_here

# R9S (GLM via Route Tokens)
ZAI_API_KEY=your_key_here
ZAI_API_BASE=https://api.r9s.ai/v1
ZAI_MODEL=glm-5.1

# MiniMax (Token Plan — Anthropic-compatible API)
MINIMAX_API_KEY=your_key_here
MINIMAX_API_BASE=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# Tavily
TAVILY_API_KEY=your_key_here

# Local paths
OBSIDIAN_VAULT_PATH=./obsidian-vault
WIKI_PATH=./obsidian-vault/wiki
RAW_PATH=./obsidian-vault/raw
UPLOADS_PATH=./obsidian-vault/uploads

# Defaults (user can override via UI)
DEFAULT_NUM_SOURCES=5
DEFAULT_SEARCH_DEPTH=basic

# App
DEBUG=true
CORS_ORIGINS=http://localhost:5173
